<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cc.ashclaw</groupId>
        <artifactId>Common4j</artifactId>
        <version>2.0.0</version>
    </parent>

    <artifactId>common4j-bom</artifactId>
    <packaging>pom</packaging>

    <name>common4j-bom</name>
    <description>Common4j Bill of Materials — unified version management</description>
    <url>https://github.com/ashc1aw/common4j</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:https://github.com/ashc1aw/common4j.git</connection>
        <developerConnection>scm:https://github.com/ashc1aw/common4j.git</developerConnection>
        <url>https://github.com/ashc1aw/common4j</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <name>Ryson</name>
            <email>ryson@ashclaw.cc</email>
            <organization>AshClaw</organization>
            <organizationUrl>https://github.com/ashc1aw</organizationUrl>
        </developer>
    </developers>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cc.ashclaw</groupId>
                <artifactId>common4j-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ashclaw</groupId>
                <artifactId>common4j-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ashclaw</groupId>
                <artifactId>common4j-crypto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ashclaw</groupId>
                <artifactId>common4j-poi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ashclaw</groupId>
                <artifactId>common4j-retry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>5.5.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>5.5.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
